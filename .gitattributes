# Normalize all text files to LF in the repository and in the working tree.
# .editorconfig (end_of_line = lf) and Prettier both require LF, so without this a Windows
# checkout with core.autocrlf=true produces CRLF files that fail `npm run format:check`.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.vsix binary
